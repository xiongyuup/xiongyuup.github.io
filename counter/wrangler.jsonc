{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiongyu-homepage-counter",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "vars": {
    "SITE_ORIGIN": "https://xiongyuup.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiongyu-homepage-visitors",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
